@model List<Medicine>
@{
    ViewData["Title"] = ViewBag.CategoryName + " Medicines";
    Layout = "_UserLayout";
}

<style>
    .category-page {
        background: #f8f9fa;
        min-height: 100vh;
        padding: 20px 0;
    }

    .category-header {
        background: linear-gradient(45deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .medicine-card {
        transition: all 0.3s ease;
        border: none;
        box-shadow: 0 3px 10px rgba(0, 123, 255, 0.08);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(0, 123, 255, 0.1);
    }

    .medicine-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 20px rgba(0, 123, 255, 0.15);
    }

    .card-img-container {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        padding: 15px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .card-img-top {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.5s ease;
    }

    .medicine-card:hover .card-img-top {
        transform: scale(1.05);
    }

    .medicine-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: bold;
        z-index: 1;
        border: 2px solid white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
      
    .medicine-badge.sale {    
        background: linear-gradient(45deg, #dc3545 0%, #c82333 100%);
        color: white;        
    }

    .medicine-badge.featured {
        background: linear-gradient(45deg, #007bff 0%, #0056b3 100%);
        color: white;
    }

    .category-badge {
        background: linear-gradient(45deg, #007bff 0%, #0056b3 100%);
        color: white;
        border-radius: 20px;
        padding: 5px 15px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 10px;
    }

    .price-tag {
        font-size: 18px;
        font-weight: 700;
        color: #28a745;
    }

    .old-price {
        text-decoration: line-through;
        color: #6c757d;
        font-size: 14px;
    }

    .stock-badge {
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 12px;
    }

    .empty-category {
        text-align: center;
        padding: 50px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .category-icon {
        font-size: 80px;
        color: #007bff;
        opacity: 0.5;
        margin-bottom: 20px;
    }

    .other-categories {
        background: white;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0, 123, 255, 0.08);
        padding: 20px;
        margin-top: 30px;
        border: 1px solid rgba(0, 123, 255, 0.1);
    }

    .cat-btn {
        border-radius: 25px;
        padding: 8px 20px;
        margin: 5px;
        transition: all 0.3s ease;
        border: 2px solid rgba(0, 123, 255, 0.3);
        color: #007bff;
        background: white;
    }

    .cat-btn:hover {
        border-color: #007bff;
        background: #007bff;
        color: white;
        transform: translateY(-2px);
    }
</style>

<div class="category-page">
    <div class="container">
        <!-- Category Header -->
        <div class="category-header">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb" style="background: transparent; padding: 0; margin-bottom: 10px;">
                    <li class="breadcrumb-item"><a href="@Url.Action("HomePage")" style="color: white; text-decoration: none;">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: white;">@ViewBag.CategoryName</li>
                </ol>
            </nav>

            <h1 class="display-6 fw-bold mb-2">@ViewBag.CategoryName Medicines</h1>
            <p class="mb-0" style="opacity: 0.9;">@Model.Count medicines found in this category</p>
        </div>

        <!-- Category Medicines -->
        @if (Model.Count == 0)
        {
            <div class="empty-category">
                <i class="fas fa-box-open category-icon"></i>
                <h3 class="mb-3" style="color: #007bff;">No medicines found</h3>
                <p class="text-muted mb-4">Currently no medicines available in this category</p>
                <a href="@Url.Action("HomePage")" class="btn btn-primary">
                    <i class="fas fa-arrow-left me-2"></i> Browse All Medicines
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var medicine in Model)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card h-100 medicine-card">
                            <!-- Badges -->
                            @if (medicine.IsOnSale)
                            {
                                <div class="medicine-badge sale">
                                    <i class="fas fa-tag me-1"></i> SALE
                                </div>
                            }
                            @if (medicine.IsFeatured)
                            {
                                <div class="medicine-badge featured">
                                    <i class="fas fa-star me-1"></i> FEATURED
                                </div>
                            }

                            <!-- Medicine Image -->
                            <div class="card-img-container">
                                <img src="@medicine.ImageUrl" class="card-img-top" alt="@medicine.Name">
                            </div>

                            <div class="card-body">
                                <!-- Category -->
                                <span class="category-badge">@medicine.Category</span>

                                <!-- Name -->
                                <h6 class="card-title" style="color: #007bff; height: 45px; overflow: hidden;">@medicine.Name</h6>

                                <!-- Price -->
                                <div class="d-flex align-items-center mb-3">
                                    <span class="price-tag">₹@medicine.Price.ToString("0.00")</span>
                                    @if (medicine.IsOnSale)
                                    {
                                        <span class="old-price ms-2">₹@((medicine.Price * 1.3m).ToString("0.00"))</span>
                                    }
                                </div>

                                <!-- Stock Status -->
                                <span class="badge @(medicine.StockStatus == "In Stock" ? "bg-success" :
                                                                                         medicine.StockStatus == "Low Stock" ? "bg-warning" : "bg-danger") stock-badge">
                            @medicine.StockStatus
                        </span>

                                <!-- Buttons -->
                                <div class="d-grid gap-2 mt-3">
                                    <a asp-action="MedicineDetail" asp-route-id="@medicine.MedicineId"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </a>
                                    <form asp-action="AddToCart" method="post">
                                        <input type="hidden" name="medicineId" value="@medicine.MedicineId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-success btn-sm w-100"
                                                @(medicine.StockStatus == "Out of Stock" ? "disabled" : "")>
                                            <i class="fas fa-cart-plus me-1"></i> Add to Cart
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                        }
            </div>

            <!-- Other Categories -->
            <div class="other-categories">
                <h5 class="mb-3" style="color: #007bff;">
                    <i class="fas fa-list me-2"></i> Browse Other Categories
                </h5>
                <div class="d-flex flex-wrap">
                    @{
                        var categories = ViewBag.Categories as List<string>;
                        if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                if (cat != ViewBag.CategoryName)
                                {
                                    <a asp-action="Category" asp-route-name="@cat" class="btn cat-btn">
                                        @cat
                                        <span class="badge bg-primary ms-2">
                                            @Model.Count(m => m.Category == cat)
                                        </span>
                                    </a>
                                }
                            }
                        }
                    }
                </div>
                <div class="text-center mt-4">
                    <a asp-action="HomePage" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i> Back to Home
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">