@model List<Medicine>
@{
    ViewData["Title"] = "Search Results";
    Layout = "_UserLayout";
}
<style>
    .medicine-card {
        transition: transform 0.3s;
        border: 1px solid #e0e0e0;
    }
     
    .medicine-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .card-img-container {
        height: 180px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
    }

    .card-img-top {
        max-height: 100%;
        width: auto;
        object-fit: contain;
    }

    .medicine-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        z-index: 1;
    }
    
    .medicine-badge.sale {
        background: #dc3545;
        color: white;
    }
    
    .medicine-badge.featured {
        background: #28a745;
        color: white;
    }
    
    .medicine-badge.new {
        background: #007bff;
        color: white;
    }
</style>
<div class="container mt-4">
    <!-- Search Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2>Search Results</h2>
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
            {
                <p class="text-muted">Showing results for: <strong>"@ViewBag.SearchQuery"</strong></p>
            }
            <p class="text-muted">@Model.Count medicines found</p>
        </div>
    </div>

    <!-- Search Results -->
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-search fa-4x text-muted mb-3"></i>
            <h4>No medicines found</h4>
            <p class="text-muted">Try searching with different keywords</p>
            <a href="@Url.Action("HomePage")" class="btn btn-primary mt-2">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var medicine in Model)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 medicine-card">
                        <!-- Medicine Badge -->
                        @if (!string.IsNullOrEmpty(medicine.BadgeType))
                        {
                            <div class="medicine-badge @medicine.BadgeType.ToLower()">
                                @medicine.BadgeType
                            </div>
                        }

                        <!-- Medicine Image -->
                        <div class="card-img-container">
                            <img src="@medicine.ImageUrl" class="card-img-top" alt="@medicine.Name">
                        </div>

                        <div class="card-body">
                            <!-- Category -->
                            <span class="badge bg-primary mb-2">@medicine.Category</span>

                            <!-- Name -->
                            <h5 class="card-title">@medicine.Name</h5>

                            <!-- Description -->
                            <p class="card-text text-muted small">@(medicine.Description.Length > 100 ? medicine.Description.Substring(0, 100) + "..." : medicine.Description)</p>

                            <!-- Price -->
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="text-success mb-0">$@medicine.Price.ToString("0.00")</h5>
                                <!-- Stock Status -->
                                <span class="badge @(medicine.StockStatus == "In Stock" ? "bg-success" : "bg-warning")">
                                    @medicine.StockStatus
                                </span>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-white">
                            <div class="d-grid">
                                <a href="@Url.Action("MedicineDetail", new { id = medicine.MedicineId })"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Search Again -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center">
                        <h5>Not finding what you need?</h5>
                        <form method="get" action="@Url.Action("Search")" class="mt-3">
                            <div class="input-group">
                                <input type="text" name="query" class="form-control"
                                       placeholder="Search medicines by name, category or description..."
                                       value="@ViewBag.SearchQuery">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i> Search Again
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

